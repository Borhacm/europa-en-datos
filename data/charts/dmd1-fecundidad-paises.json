 "title": {
  "es": "La fecundidad ha bajado desde 2014 en 23 de los 27 países; solo ha subido en Chipre, Portugal, Eslovaquia y Bulgaria",
  "en": "Fertility has fallen since 2014 in 23 of the 27 countries; it has only risen in Cyprus, Portugal, Slovakia and Bulgaria"
 },
 "subtitle": {
  "es": "Tasa de fecundidad: hijos por mujer, 2014 y 2024. UE: 1,34",
  "en": "Fertility rate: births per woman, 2014 and 2024. EU: 1.34"
 },
 "unit": {
  "es": "hijos por mujer",
  "en": "births per woman"
 },
 "source": {
  "name": "Eurostat",
  "dataset": "demo_find",
