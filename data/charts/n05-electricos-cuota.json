 "title": {
  "es": "En Dinamarca, más de dos de cada tres coches nuevos son eléctricos; en Croacia, menos de dos de cada cien",
  "en": "In Denmark, more than two in three new cars are electric; in Croatia, fewer than two in a hundred"
 },
 "subtitle": {
  "es": "Turismos eléctricos de batería, en % de los turismos nuevos matriculados, 2025",
  "en": "Battery electric cars as a % of new passenger car registrations, 2025"
 },
 "unit": {
  "es": "% de los turismos nuevos",
  "en": "% of new passenger cars"
 },
 "source": {
  "name": "Eurostat",
