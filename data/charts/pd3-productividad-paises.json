 "title": {
  "es": "Desde 2004, la productividad por hora se ha más que duplicado en Rumanía; en Italia apenas ha cambiado y en Grecia ha caído",
  "en": "Since 2004, output per hour has more than doubled in Romania; in Italy it has barely changed and in Greece it has fallen"
 },
 "subtitle": {
  "es": "Variación de la productividad real por hora trabajada entre 2004 y 2025, en %",
  "en": "Change in real labour productivity per hour worked between 2004 and 2025, in %"
 },
