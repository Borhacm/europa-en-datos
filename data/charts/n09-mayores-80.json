 "title": {
  "es": "En Italia, el 7,8 % de los habitantes tiene 80 años o más; en Eslovaquia, el 3,7 %",
  "en": "In Italy, 7.8% of residents are 80 or older; in Slovakia, 3.7%"
 },
 "subtitle": {
  "es": "Población de 80 años o más, en % de la población total, a 1 de enero de 2025",
  "en": "Population aged 80 or older, as % of the total population, on 1 January 2025"
 },
