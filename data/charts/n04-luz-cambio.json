 "title": {
  "es": "Desde 2021, la luz de los hogares se ha encarecido en 26 de los 27 países; en la UE, un 31,5 %",
  "en": "Since 2021, household electricity has become more expensive in 26 of the 27 countries; in the EU, by 31.5%"
 },
 "subtitle": {
  "es": "Precio de la electricidad para los hogares, con impuestos, primer semestre de 2021 y segundo semestre de 2025, en céntimos de euro por kWh",
  "en": "Household electricity price including taxes, first half of 2021 and second half of 2025, in euro cents per kWh"
 },
 "unit": {
  "es": "céntimos de euro por kWh",
  "en": "euro cents per kWh"
 },
 "source": {
