 "title": {
  "es": "Desde 2021, la electricidad para la industria se ha encarecido en los 27 países; en Chipre cuesta 3,5 veces lo que en Finlandia",
  "en": "Since 2021, electricity for industry has become more expensive in all 27 countries; in Cyprus it costs 3.5 times as much as in Finland"
 },
 "subtitle": {
  "es": "Precio de la electricidad para la industria, sin IVA ni impuestos recuperables, primer semestre de 2021 y segundo semestre de 2025, en céntimos de euro por kWh",
  "en": "Electricity price for industry, excluding VAT and recoverable taxes, first half of 2021 and second half of 2025, in euro cents per kWh"
 },
 "unit": {
  "es": "céntimos de euro por kWh",
  "en": "euro cents per kWh"
 },
 "source": {
