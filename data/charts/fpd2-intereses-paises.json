 "title": {
  "es": "Desde 2021, el pago de intereses ha subido en 23 de los 27 países; Italia y Hungría dedican a ello casi el 4 % de su PIB",
  "en": "Since 2021, interest payments have risen in 23 of the 27 countries; Italy and Hungary spend almost 4% of their GDP on them"
 },
 "subtitle": {
  "es": "Intereses pagados por las administraciones públicas, en % del PIB, 2021 y 2025",
  "en": "Interest paid by general government, as % of GDP, 2021 and 2025"
 },
 "unit": {
  "es": "% del PIB",
  "en": "% of GDP"
 },
 "source": {
  "name": "Eurostat",
