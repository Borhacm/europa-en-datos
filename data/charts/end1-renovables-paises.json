 "title": {
  "es": "Suecia cubre con renovables el 62,9 % de su consumo de energía; Bélgica, el 14,3 %",
  "en": "Sweden covers 62.9% of its energy consumption with renewables; Belgium, 14.3%"
 },
 "subtitle": {
  "es": "Energías renovables, en % del consumo final bruto de energía",
  "en": "Renewable energy, as % of gross final energy consumption"
 },
 "unit": {
  "es": "% del consumo final bruto",
  "en": "% of gross final consumption"
 },
 "source": {
  "name": "Eurostat",
