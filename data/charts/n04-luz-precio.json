 "title": {
  "es": "En Irlanda, la luz de los hogares cuesta 3,7 veces lo que en Hungría",
  "en": "Household electricity in Ireland costs 3.7 times as much as in Hungary"
 },
 "subtitle": {
  "es": "Precio de la electricidad para los hogares, segundo semestre de 2025, en céntimos de euro por kWh",
  "en": "Household electricity price, second half of 2025, in euro cents per kWh"
 },
 "unit": {
  "es": "céntimos de euro por kWh",
  "en": "euro cents per kWh"
 },
 "source": {
