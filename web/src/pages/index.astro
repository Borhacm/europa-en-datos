---
// La raíz lleva al inglés si el navegador no está en español, y si no al español (GitHub Pages no redirige por cabeceras).
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      var l = (navigator.languages && navigator.languages[0]) || navigator.language || "es";
      location.replace(/^es\b/i.test(l) ? "/es/" : "/en/");
    </script>
    <meta http-equiv="refresh" content="0; url=/es/" />
    <link rel="canonical" href="https://europa.bocal.online/es/" />
    <title>Europa en datos</title>
  </head>
  <body><a href="/es/">Europa en datos</a> / <a href="/en/">Europe in data</a></body>
</html>
