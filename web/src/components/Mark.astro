---
// 27 puntos, uno por Estado miembro, en una rejilla de 9 x 3.
interface Props { size?: number; class?: string }
const { size = 28, class: cls } = Astro.props;
const dots = Array.from({ length: 27 }, (_, i) => ({ x: (i % 9) * 4 + 2, y: Math.floor(i / 9) * 4 + 2 }));
---
<svg class={cls} width={size} height={(size * 12) / 36} viewBox="0 0 36 12" aria-hidden="true">
  {dots.map((d) => <circle cx={d.x} cy={d.y} r="1.35" fill="currentColor" />)}
</svg>
