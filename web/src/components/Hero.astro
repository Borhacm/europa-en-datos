---
import { loadChart } from "../lib/data";
import { paths, type Lang } from "../lib/i18n";

interface Props { lang: Lang }
const { lang } = Astro.props;

// Último año completo de Epoch AI, regla "participa"
const chart = loadChart("g3-modelos-ia");
const year = String(Number(chart.partial_year) - 1);
const count = (geo: string) =>
  chart.rows.find((r) => r.geo === geo && r.time === year && r.rule === "participa")?.value ?? 0;

const blocs = [
  { geo: "USA", color: "var(--usa)" },
  { geo: "CHN", color: "var(--chn)" },
  { geo: "EU27", color: "var(--eu)" },
].map((b) => ({ ...b, n: count(b.geo), name: chart.geos[b.geo][lang] }));

const copy = {
  es: {
    h1: ["Europa usa la IA.", "Casi no la fabrica."],
    dek: `En ${year}, las organizaciones de la UE participaron en ${blocs[2].n} de los modelos de IA destacados del año. Las de Estados Unidos, en ${blocs[0].n}. Las de China, en ${blocs[1].n}.`,
    caption: `Cada punto es un modelo de IA destacado publicado en ${year}, según el país de las organizaciones que lo desarrollaron.`,
    eu: "Mistral OCR, de Mistral AI (Francia)",
    source: "Fuente: Epoch AI",
    cta: "Leer la historia completa",
    chartLabel: `Modelos de IA destacados en ${year}: Estados Unidos ${blocs[0].n}, China ${blocs[1].n}, Unión Europea ${blocs[2].n}.`,
  },
  en: {
    h1: ["Europe uses AI.", "It barely builds it."],
    dek: `In ${year}, EU organisations took part in ${blocs[2].n} of the year's notable AI models. US organisations took part in ${blocs[0].n}. Chinese ones, in ${blocs[1].n}.`,
    caption: `Each dot is a notable AI model released in ${year}, by country of the organisations that developed it.`,
    eu: "Mistral OCR, by Mistral AI (France)",
    source: "Source: Epoch AI",
    cta: "Read the full story",
    chartLabel: `Notable AI models in ${year}: United States ${blocs[0].n}, China ${blocs[1].n}, European Union ${blocs[2].n}.`,
  },
}[lang];

const PER_ROW = 16;
let order = 0;
---
<section class="hero wrap">
  <div class="hero-text">
    <h1>{copy.h1.map((l) => <span>{l}</span>)}</h1>
    <p class="dek">{copy.dek}</p>
    <a class="cta" href={paths.theme[lang]}>{copy.cta}</a>
  </div>

  <figure class="units" aria-label={copy.chartLabel} role="img">
    {blocs.map((b) => (
      <div class={`unit-row${b.geo === "EU27" ? " eu" : ""}`}>
        <div class="unit-label" aria-hidden="true">
          <span class="unit-n">{b.n}</span>
          <span class="unit-name">{b.name}</span>
        </div>
        <div class="dots" aria-hidden="true" style={`--per-row:${PER_ROW}`}>
          {Array.from({ length: b.n }, () => (
            <span class="dot" style={`background:${b.color};--i:${order++}`}></span>
          ))}
          {b.geo === "EU27" && <span class="dot-note">{copy.eu}</span>}
        </div>
      </div>
    ))}
    <figcaption>{copy.caption} {copy.source}.</figcaption>
  </figure>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: end;
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3rem, 6vw, 5rem);
  }
  h1 {
    font-size: clamp(3.4rem, 9.2vw, 7.6rem);
    line-height: 0.88;
    letter-spacing: -0.015em;
  }
  h1 span { display: block; }
  .dek {
    margin-top: 1.75rem;
    max-width: 30rem;
    font-size: clamp(1.15rem, 1.6vw, 1.35rem);
    line-height: 1.45;
    color: var(--ink-2);
  }
  .cta {
    display: inline-block;
    margin-top: 0.5rem;
    font-family: var(--font-semi);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--paper);
    background: var(--eu);
    padding: 0.8rem 1.2rem;
    border-radius: 4px;
    text-decoration: none;
  }
  .cta:hover { background: color-mix(in srgb, var(--eu) 85%, var(--ink)); }

  .units { margin: 0; display: grid; gap: 1.5rem; }
  .unit-row { display: grid; grid-template-columns: 7.5rem 1fr; gap: 1rem; align-items: start; }
  .unit-label { display: grid; line-height: 1; }
  .unit-n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 3rem;
    line-height: 0.9;
  }
  .unit-name { font-family: var(--font-semi); font-size: 0.95rem; color: var(--ink-2); margin-top: 0.3rem; }
  .dots {
    display: grid;
    grid-template-columns: repeat(var(--per-row), 1fr);
    gap: 5px;
    max-width: 22rem;
    padding-top: 0.35rem;
  }
  .dot {
    aspect-ratio: 1;
    border-radius: 50%;
    animation: dot-in 420ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
    animation-delay: calc(var(--i) * 14ms);
  }
  .eu .dots { grid-template-columns: repeat(var(--per-row), 1fr); }
  .eu .dot { animation-delay: calc(var(--i) * 14ms + 350ms); }
  .dot-note {
    grid-column: 2 / -1;
    align-self: center;
    font-family: var(--font-semi);
    font-size: 0.92rem;
    color: var(--ink-2);
    padding-left: 0.4rem;
    white-space: nowrap;
  }
  .units figcaption { font-size: 0.88rem; color: var(--ink-3); max-width: 30rem; line-height: 1.45; }

  @keyframes dot-in {
    from { transform: scale(0); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; align-items: start; }
    .unit-row { grid-template-columns: 5.5rem 1fr; }
    .unit-n { font-size: 2.4rem; }
  }
</style>
