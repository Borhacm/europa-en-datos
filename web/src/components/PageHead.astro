---
interface Props { title: string; dek?: string; meta?: string }
const { title, dek, meta } = Astro.props;
---
<header class="wrap page-head">
  <h1>{title}</h1>
  {dek && <p class="dek">{dek}</p>}
  {meta && <p class="meta">{meta}</p>}
  <slot />
</header>

<style>
  .page-head { padding-block: clamp(3rem, 7vw, 5.5rem) 2.5rem; }
  h1 { font-size: clamp(3.4rem, 9.5vw, 7.6rem); line-height: 0.86; }
  .dek { margin-top: 1.5rem; max-width: 38rem; font-size: clamp(1.15rem, 1.7vw, 1.4rem); line-height: 1.45; color: var(--ink-2); }
  .meta { margin: 0.5rem 0 0; font-family: var(--font-semi); font-size: 0.95rem; color: var(--ink-3); }
</style>
